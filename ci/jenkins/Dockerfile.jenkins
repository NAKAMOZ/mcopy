# Jenkins, preconfigured so there is no setup wizard to click through.
#
# The stock image has no docker CLI, and the pipeline needs one: the build runs
# in a sibling container started through the mounted docker socket.
FROM jenkins/jenkins:lts-jdk21

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg \
         -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] \
https://download.docker.com/linux/debian bookworm stable" \
         > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*
USER jenkins

COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt

# Everything this Jenkins knows comes from jenkins.yaml, so the first-run
# wizard would only be in the way.
COPY jenkins.yaml /var/jenkins_home/casc.yaml

# ALLOW_LOCAL_CHECKOUT is off by default because on a shared Jenkins it would
# let any job read arbitrary host paths through a "git" URL. This instance is
# bound to localhost, has one user, and exists precisely to build the working
# copy bind-mounted at /repo — read-only — so the checkout it blocks is the
# whole point.
ENV CASC_JENKINS_CONFIG=/var/jenkins_home/casc.yaml \
    JAVA_OPTS="-Djenkins.install.runSetupWizard=false \
-Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true"
