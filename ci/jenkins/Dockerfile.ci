# The build agent: Rust plus everything gpui links against.
#
# These are the same packages .github/workflows/ci.yml installs with apt on the
# ubuntu runner. Baking them into an image is the whole reason a local run can
# be fast — the GitHub job reinstalls them on every run.
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        libx11-dev libxcb1-dev libxkbcommon-dev libxkbcommon-x11-dev \
        libwayland-dev libfontconfig1-dev libfreetype6-dev \
        libvulkan-dev libssl-dev pkg-config \
        appstream desktop-file-utils \
        curl ca-certificates file zsync \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt

# Jenkins starts the agent as `-u 1000:1000`, and the cache directories arrive
# as named volumes. Docker seeds an empty volume from the image — ownership and
# permissions included — so these directories have to exist here and be
# writable, or the volumes come up owned by root and cargo cannot write to its
# own registry. Creating them after the fact does not help: a volume is only
# ever initialised once.
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_TARGET_DIR=/cargo-target
RUN mkdir -p /usr/local/cargo/registry /cargo-target \
    && chmod -R 777 /usr/local/cargo /usr/local/rustup /cargo-target

# uid 1000 does not exist in this image, so it gets no home directory — and the
# shell-integration tests register menu entries under the user's own
# directories, which is the behaviour they exist to assert. Without somewhere
# writable to call home they fail with "Permission denied", where the GitHub
# runner passes because its user has a real home. Ephemeral by design: each
# build starts from an empty one.
RUN mkdir -p /home/ci && chmod 777 /home/ci
ENV HOME=/home/ci
